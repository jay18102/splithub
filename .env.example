# SplitSub Environment Configuration
PROJECT_NAME="SplitSub"
API_V1_STR="/api"
SECRET_KEY="splitsub_jwt_secret_super_secure_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Database URL
# For SQLite (default development):
DATABASE_URL="sqlite:///./splitsub.db"
# For PostgreSQL (production):
# DATABASE_URL="postgresql://user:password@localhost:5432/splitsub"

# Default Demo UPI ID for simulated payments
DEFAULT_UPI_ID="splitsub@icici"
DEFAULT_UPI_NAME="SplitSub Settlements"

# Payment Gateway Placeholders (for Razorpay / Cashfree future extension)
PAYMENT_GATEWAY_KEY="rzp_test_placeholder"
PAYMENT_GATEWAY_SECRET="rzp_secret_placeholder"

# Frontend Origin for CORS
FRONTEND_URL="http://localhost:5173"
